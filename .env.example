# Where the SQLite database, uploads and backups live (mount a persistent volume here in production).
DATA_DIR=/data

# Public URL of the site (used for canonical URLs, sitemap, JSON-LD, auth cookies).
SITE_URL=https://mustanggym.eu
BETTER_AUTH_URL=https://mustanggym.eu

# Long random string: `openssl rand -hex 32`
BETTER_AUTH_SECRET=

# Optional: creates the first admin on start-up when no user exists yet. Remove after the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
